{
  "name": "omgvibe",
  "version": "1.0.0",
  "description": "Run Claude Code, Codex, opencode and other coding agents on OhMyGPT with one command.",
  "type": "module",
  "bin": {
    "omgvibe": "bin/omgvibe.mjs",
    "ov": "bin/ov.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "ohmygpt",
    "claude-code",
    "codex",
    "opencode",
    "coding-agent",
    "llm-gateway",
    "cli"
  ],
  "author": "DogeNet LLC",
  "license": "MIT",
  "devDependencies": {
    "@clack/prompts": "^1.9.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.5.0",
    "cross-spawn": "^7.0.6",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DogeNet-LLC/omgvibe.git"
  },
  "bugs": {
    "url": "https://github.com/DogeNet-LLC/omgvibe/issues"
  },
  "homepage": "https://github.com/DogeNet-LLC/omgvibe#readme"
}
